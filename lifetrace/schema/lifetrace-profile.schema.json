{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lifetrace:profile:1.0.0",
  "title": "LifeTrace portable life archive 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "archive_id", "revision", "updated_at", "subject", "preferences", "entries", "tombstones"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "archive_id": {"$ref": "#/$defs/uuid"},
    "revision": {"type": "integer", "minimum": 1},
    "updated_at": {"type": "string", "format": "date-time"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["display_name"],
      "properties": {"display_name": {"type": "string", "minLength": 1}, "notes": {"type": "string"}}
    },
    "preferences": {
      "type": "object", "additionalProperties": false,
      "required": ["recording_mode"],
      "properties": {"recording_mode": {"enum": ["balanced", "light", "deep"]}}
    },
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "tombstones": {"type": "array", "items": {"$ref": "#/$defs/tombstone"}}
  },
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "ref"],
      "properties": {
        "type": {"enum": ["subject", "person", "document", "import"]},
        "ref": {"type": "string", "minLength": 1},
        "quote": {"type": "string"}
      }
    },
    "prior_version": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "content", "updated_at"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "content": {"type": "string", "minLength": 1},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "status", "title", "content", "recorded_at", "updated_at", "version", "sources", "visibility", "history"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"},
        "kind": {"enum": ["event", "reflection", "person", "place", "theme"]},
        "status": {"const": "confirmed"},
        "title": {"type": "string", "minLength": 1},
        "content": {"type": "string", "minLength": 1},
        "when_date": {"type": "string", "format": "date"},
        "when_text": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "version": {"type": "integer", "minimum": 1},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
        "visibility": {"enum": ["private", "shareable"]},
        "history": {"type": "array", "items": {"$ref": "#/$defs/prior_version"}}
      },
      "not": {"required": ["when_date", "when_text"]}
    },
    "tombstone": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "deleted_at", "version", "reason"],
      "properties": {
        "id": {"$ref": "#/$defs/uuid"},
        "deleted_at": {"type": "string", "format": "date-time"},
        "version": {"type": "integer", "minimum": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
